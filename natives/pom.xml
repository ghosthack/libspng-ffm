<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.github.ghosthack</groupId>
    <artifactId>libspng-ffm-parent</artifactId>
    <version>0.7.4-0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>libspng-ffm-natives</artifactId>
  <packaging>pom</packaging>
  <name>libspng-ffm natives</name>
  <description>From-source libspng and zlib shared libraries, one classifier jar per platform</description>
  <licenses>
    <license>
      <name>BSD 2-Clause, PNG Reference Library License v2, and zlib License</name>
      <url>https://github.com/randy408/libspng/blob/v0.7.4/LICENSE</url>
      <distribution>repo</distribution>
      <comments>Unmodified libspng and zlib; all license texts and build information are included in each jar.</comments>
    </license>
  </licenses>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.2</version>
        <executions>
          <execution>
            <id>natives-jar</id><phase>package</phase><goals><goal>jar</goal></goals>
            <configuration>
              <classesDirectory>src/main/resources</classesDirectory>
              <classifier>${native.classifier}</classifier>
              <includes><include>libspng-natives/${native.classifier}/**</include></includes>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <profile>
      <id>all-natives</id>
      <properties><native.classifier>macos-arm64</native.classifier></properties>
      <build><plugins><plugin>
        <groupId>org.apache.maven.plugins</groupId><artifactId>maven-jar-plugin</artifactId><version>3.4.2</version>
        <executions>
          <execution><id>natives-jar-windows</id><phase>package</phase><goals><goal>jar</goal></goals><configuration>
            <classesDirectory>src/main/resources</classesDirectory><classifier>windows-x64</classifier>
            <includes><include>libspng-natives/windows-x64/**</include></includes>
          </configuration></execution>
          <execution><id>natives-jar-linux</id><phase>package</phase><goals><goal>jar</goal></goals><configuration>
            <classesDirectory>src/main/resources</classesDirectory><classifier>linux-x64</classifier>
            <includes><include>libspng-natives/linux-x64/**</include></includes>
          </configuration></execution>
        </executions>
      </plugin></plugins></build>
    </profile>
  </profiles>
</project>
